<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_sale_order_reject_wizard" model="ir.ui.view">
        <field name="name">sale.order.reject.wizard.form</field>
        <field name="model">sale.order.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Sale Order">
                <group>
                    <field name="rejection_reason"/>
                </group>
                <footer>
                    <button name="action_reject_confirm" string="Reject" type="object" class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>