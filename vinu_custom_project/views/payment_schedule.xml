<odoo>

    <record id="view_payment_schedule_list" model="ir.ui.view">
        <field name="name">payment.schedule.list</field>
        <field name="model">payment.schedule</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="payment_date"/>
                <field name="payment_description"/>
                <field name="amount"/>
            </list>
        </field>
    </record>

    <record id="view_payment_schedule_form" model="ir.ui.view">
        <field name="name">payment.schedule.form</field>
        <field name="model">payment.schedule</field>
        <field name="arch" type="xml">
            <form string="Payment Schedule">
                <sheet>
                    <group>
                        <field name="payment_date"/>
                        <field name="amount"/>
                    </group>
                    <group>
                        <field name="payment_description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action that opens as popup and is filtered by project -->
    <record id="action_payment_schedule_popup" model="ir.actions.act_window">
        <field name="name">Payment Schedule</field>
        <field name="res_model">payment.schedule</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_payment_schedule_list"/>
        <field name="target">new</field> <!-- popup -->
        <field name="domain">[('project_id', '=', active_id)]</field>
        <field name="context">{'default_project_id': active_id}</field>
    </record>
</odoo>