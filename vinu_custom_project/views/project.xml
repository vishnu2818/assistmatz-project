<odoo>

    <record id="project_project_list_inherit_payment_button" model="ir.ui.view">
        <field name="name">project.project.list.inherit.payment.button</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project"/>
        <field name="arch" type="xml">

            <!-- Add button after the project name column -->
            <xpath expr="//list/field[@name='partner_id']" position="after">
                    <button name="action_view_product_list"
                            string="View (Product List)"
                            type="object"
                            class="btn btn-link"/>

                    <button name="action_view_payment_schedule"
                            string="View (Payment Schedules)"
                            type="object"
                            class="btn btn-link"/>
                    <field name="cost"/>
<!--                    <field name="stage_id"/>-->
            </xpath>

        </field>
    </record>

    <record id="vcp_project_form_inherit_assigned_employees" model="ir.ui.view">
        <field name="name">project.project.form.inherit.assigned.employees</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet//group/group[2]" position="inside">
                <field name="assigned_employee_ids"
                       widget="many2many_tags"
                       placeholder="Select employees..."/>
            </xpath>

            <!-- Insert AFTER the Settings page -->
            <xpath expr="//page[@name='settings']" position="after">
                <page name="daily_updates" string="Daily Updates">
                    <field name="daily_update_ids" widget="one2many_list">
                    </field>
                </page>
                <page name="payment_schedule" string="Payment Schedule">
                    <field name="payment_schedule_ids" widget="one2many_list">
                    </field>
                </page>
            </xpath>

        </field>
    </record>
</odoo>