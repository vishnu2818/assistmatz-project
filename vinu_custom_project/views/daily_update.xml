<odoo>
    <!-- Tree view -->
    <record id="view_daily_update_list" model="ir.ui.view">
        <field name="name">daily.update.list</field>
        <field name="model">daily.update</field>
        <field name="arch" type="xml">
            <list editable="bottom" decoration-success="status == 'completed'"
                  decoration-warning="status == 'pending'">
                <field name="update_date" readonly="allow_edit_after_edit == False"/>
                <field name="employee_id" readonly="allow_edit_after_edit == False"/>
                <field name="description"/>
                <field name="attachment_ids" widget="many2many_binary"/>
                <field name="status"/>
                <field name="allow_edit_after_edit" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_daily_update_form" model="ir.ui.view">
        <field name="name">daily.update.form</field>
        <field name="model">daily.update</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="update_date" readonly="allow_edit_after_edit == False"/>
                        <field name="employee_id" readonly="allow_edit_after_edit == False"/>
                        <field name="description"/>
                        <field name="attachment_ids" widget="many2many_binary"/>
                        <field name="status" widget="badge"/>
                        <field name="allow_edit_after_edit" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
