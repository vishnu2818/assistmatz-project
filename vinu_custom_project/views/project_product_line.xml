<odoo>

    <!-- Tree view -->
    <record id="view_project_product_line_list" model="ir.ui.view">
        <field name="name">project.product.line.list</field>
        <field name="model">project.product.line</field>
        <field name="arch" type="xml">
            <list create="false">
<!--                <field name="quotation_ids" widget="many2many_tags"/>-->
                <field name="sequence"/>
                <field name="product_id"/>
                <field name="quantity"/>
<!--                <field name="project_id"/>-->
            </list>
        </field>
    </record>

    <!-- Form view (if user opens a line) -->
    <record id="view_project_product_line_form" model="ir.ui.view">
        <field name="name">project.product.line.form</field>
        <field name="model">project.product.line</field>
        <field name="arch" type="xml">
            <form string="Project Product Line" create="false">
                <sheet>
                    <group>
<!--                        <field name="project_id" readonly="0"/>-->
<!--                        <field name="sequence" readonly="0"/>-->
                        <field name="product_id" readonly="0"/>
                        <field name="quantity" readonly="0"/>
                        <field name="quotation_ids" readonly="0" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Popup action -->
    <record id="action_project_product_line_popup" model="ir.actions.act_window">
        <field name="name">Project Product List</field>
        <field name="res_model">project.product.line</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_project_product_line_list"/>
        <field name="target">new</field>
        <field name="domain">[('project_id', '=', active_id)]</field>
        <field name="context">{'default_project_id': active_id}</field>
        <!-- disable search in the popup and set default project -->
        <field name="search_view_id" eval="False"/>
    </record>

</odoo>
