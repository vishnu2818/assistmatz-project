<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="crm_lead_form_deadline_class" model="ir.ui.view">
            <field name="name">crm.lead.form.deadline.class</field>
            <field name="model">crm.lead</field>
            <field name="inherit_id" ref="crm.crm_lead_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='date_deadline']" position="replace">
                    <div>
                        <span style="color:red; font-weight:bold;">
                            <field name="date_deadline"/>
                        </span>
                    </div>
                </xpath>
            </field>
        </record>
        <record id="view_crm_lead_form_mandatory_fields" model="ir.ui.view">
            <field name="name">crm.lead.form.mandatory.fields</field>
            <field name="model">crm.lead</field>
            <field name="inherit_id" ref="crm.crm_lead_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='email_from']" position="attributes">
                    <attribute name="required">1</attribute>
                </xpath>
                <xpath expr="//field[@name='phone']" position="attributes">
                    <attribute name="required">1</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>







































































































