<odoo>
  <template id="crm_lead_form_deadline_highlight" inherit_id="crm.crm_lead_view_form" name="CRM Lead Form Deadline Highlight">
    <xpath expr="//field[@name='date_deadline']" position="replace">
      <field name="date_deadline"
             t-att-style="record.is_deadline_passed.raw_value ? 'color:red;' : ''"/>
    </xpath>
  </template>
</odoo>























