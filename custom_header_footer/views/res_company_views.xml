<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_company_form_inherit_header_footer" model="ir.ui.view">
        <field name="name">res.company.form.custom.header.footer</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">

            <xpath expr="//notebook" position="inside">
                <page string="Report Header/Footer">
                    <group>
                        <field name="custom_header_image" widget="image"/>
                        <field name="custom_footer_image" widget="image"/>
                    </group>
                </page>
            </xpath>

        </field>
    </record>

</odoo>
