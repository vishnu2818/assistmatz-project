<odoo>
    <record id="view_invoice_reject_wizard" model="ir.ui.view">
        <field name="name">invoice.reject.wizard.form</field>
        <field name="model">invoice.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Invoice">
                <group>
                    <field name="rejection_reason" placeholder="Enter rejection reason..."/>
                </group>
                <footer>
                    <button name="action_confirm_reject" type="object" string="Reject" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_invoice_reject_wizard" model="ir.actions.act_window">
        <field name="name">Reject Invoice</field>
        <field name="res_model">invoice.reject.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
