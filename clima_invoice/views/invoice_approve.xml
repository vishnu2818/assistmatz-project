<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_invoice_approve_list" model="ir.ui.view">
        <field name="name">invoice.approve.list</field>
        <field name="model">invoice.approve</field>
        <field name="arch" type="xml">
            <list string="Invoice Approvals" editable="bottom" create="false" edit="false">
                <field name="move_id" widget="many2one"/>
                <field name="requested_by"/>
<!--                <field name="approver_id"/>-->
                <field name="approval_level"/>
                <field name="rejection_reason"/>
                <field name="state"/>

                <!-- Approve Button -->
                <button name="action_approve"
                        type="object"
                        string="Approve"
                        class="btn-primary"
                        groups="clima_invoice.group_invoice_manager,clima_sale.group_general_manager"
                        invisible="state != 'pending'"
                />

                <!-- Reject Button (opens reason wizard or uses action_reject) -->
                <button name="action_reject"
                        type="object"
                        string="Reject"
                        class="btn-danger"
                        groups="clima_invoice.group_invoice_manager,clima_sale.group_general_manager"
                        invisible="state != 'pending'"
                />
            </list>
        </field>
    </record>


    <record id="view_invoice_approve_search" model="ir.ui.view">
        <field name="name">invoice.approve.search</field>
        <field name="model">invoice.approve</field>
        <field name="arch" type="xml">
            <search string="Invoice Approval Search">
                <field name="move_id"/>
                <field name="approver_id"/>
                <field name="approval_level"/>
                <filter name="pending" string="Pending" domain="[('state','=','pending')]"/>
                <filter name="approved" string="Approved" domain="[('state','=','approved')]"/>
                <filter name="rejected" string="Rejected" domain="[('state','=','rejected')]"/>
            </search>
        </field>
    </record>


    <record id="action_invoice_approval" model="ir.actions.act_window">
        <field name="name">Invoice Approvals</field>
        <field name="res_model">invoice.approve</field>
        <field name="view_mode">list,search</field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_invoice_approval"
              name="Invoice Approvals"
              parent="accountant.menu_accounting"
              action="action_invoice_approval"
              sequence="5"/>

</odoo>
