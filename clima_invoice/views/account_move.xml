<?xml version="1.0" encoding="UTF-8" ?>
<odoo>


    <record id="view_move_form_inherit_approval" model="ir.ui.view">
        <field name="name">invoice.form.approval.state</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="selection_add">[('to_approve','Waiting for Approvals')]</attribute>
            </xpath>
        </field>
    </record>

</odoo>